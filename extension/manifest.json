{
  "manifest_version": 3,
  "name": "QuickClarify",
  "version": "0.1.0",
  "description": "A little clarity, right where you need it. Explain highlighted text with AI.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "action": {"default_popup": "popup.html", "default_title": "QuickClarify"},
  "background": {"service_worker": "background.js"},
  "commands": {
    "clarify-selection": {
      "suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"},
      "description": "Explain highlighted text on this page"
    }
  }
}
