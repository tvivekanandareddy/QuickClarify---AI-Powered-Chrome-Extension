# Copy this file to .env. Never commit your real .env file.
# Demo mode works without an API key and makes no paid API calls.
DEMO_MODE=true

# For live AI: paste your own key in .env, then set DEMO_MODE=false.
OPENAI_API_KEY=

# Use a text-capable Responses API model available to your API project.
OPENAI_MODEL=gpt-4.1-mini
